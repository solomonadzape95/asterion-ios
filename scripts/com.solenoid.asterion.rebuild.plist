<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.solenoid.asterion.rebuild</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/solenoid/Documents/Development/Personal/asterion-ios/scripts/rebuild-asterion.sh</string>
    </array>

    <!-- Every 5 days (432000s), safely under the 7-day free-signing expiry.
         If the Mac is asleep at fire time, it runs at next wake. -->
    <key>StartInterval</key>
    <integer>432000</integer>

    <!-- Also rebuild once right after the agent is loaded. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/solenoid/Library/Logs/asterion-rebuild.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/solenoid/Library/Logs/asterion-rebuild.err.log</string>
</dict>
</plist>
